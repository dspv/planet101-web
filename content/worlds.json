[
  {"id": "mercury", "name": "Меркурий", "kind": "Планета, ближайшая к Солнцу", "temp": "от −173 до +427 °C", "g": 0.38, "day": "176 земных суток", "air": "Почти нет (экзосфера)", "pressure": "≈0", "desc": "Днём камни раскаляются так, что плавится свинец, ночью — мороз сильнее антарктического. Воздуха нет, поэтому небо чёрное даже при огромном Солнце.", "sky": ["#000005", "#0b0b14"], "ground": ["#5c5852", "#77726b", "#948e85"], "amp": [40, 30, 18], "sun": {"r": 70, "color": "#fff6dc", "x": 0.72, "y": 0.22}, "stars": 1, "weather": "none", "survival": {"threats": [{"kind": "vacuum", "factIds": ["mercury.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue"]}, {"kind": "heat", "factIds": ["mercury.surface_temp"]}, {"kind": "cold", "factIds": ["mercury.surface_temp"]}], "helmetOff": {"text": "Через 9–11 секунд потеряешь сознание: вокруг почти пустота, а вода в теле закипает, как только давление ниже 6,3 кПа.", "factIds": ["mercury.pressure", "earth.vacuum_consciousness", "earth.body_boiling_pressure"]}}},
  {"id": "venus", "name": "Венера", "kind": "Планета с парниковым адом", "temp": "+464 °C", "g": 0.9, "day": "117 земных суток", "air": "Углекислый газ, облака серной кислоты", "pressure": "92 атм — как на глубине 900 м", "desc": "Самая горячая планета Солнечной системы, хотя Меркурий ближе к Солнцу. Свет пробивается сквозь облака тусклым оранжевым маревом.", "sky": ["#b8792a", "#e8b660"], "ground": ["#6b4a2a", "#7f5531", "#94633a"], "amp": [30, 22, 14], "stars": 0, "weather": "haze", "survival": {"threats": [{"kind": "crush", "factIds": ["venus.pressure", "venus.pressure_depth"]}, {"kind": "heat", "factIds": ["venus.surface_temp"]}, {"kind": "no_oxygen", "factIds": ["venus.atmosphere", "earth.anoxia_fatal"]}], "helmetOff": {"text": "Шлем не снять: снаружи давит 92 бар — как на глубине ≈930 м в океане — и жарит +464 °C. Даже посадочные аппараты «Венера» выдерживали тут не больше двух часов.", "factIds": ["venus.pressure", "venus.pressure_depth", "venus.surface_temp"]}}},
  {"id": "earth", "name": "Земля", "kind": "Наш дом", "temp": "в среднем +15 °C", "g": 1, "day": "24 часа", "air": "Азот и кислород", "pressure": "1 атм", "desc": "Единственное известное место с жидкой водой на поверхности и жизнью. Точка отсчёта для всех остальных миров.", "sky": ["#3d7fd1", "#a9d3f2"], "ground": ["#5e7f63", "#4f7a45", "#3f6a36"], "amp": [60, 36, 16], "sun": {"r": 26, "color": "#fffbe6", "x": 0.75, "y": 0.2}, "stars": 0, "weather": "clouds", "survival": {"threats": [], "safe": [{"kind": "air", "factIds": ["earth.oxygen", "earth.pressure"]}, {"kind": "radiation", "factIds": ["earth.radiation_dose"]}], "helmetOff": {"text": "Дыши спокойно: в воздухе 20,95 % кислорода, а давление — 1 атм. Из десяти миров это единственный, где шлем можно снять.", "factIds": ["earth.oxygen", "earth.pressure", "earth.life_water"]}}},
  {"id": "moon", "name": "Луна", "kind": "Спутник Земли", "temp": "от −173 до +127 °C", "g": 0.165, "day": "29,5 земных суток", "air": "Нет", "pressure": "0", "desc": "Здесь гуляли двенадцать человек. Прыжок уносит в шесть раз выше, а следы в пыли остаются на миллионы лет.", "sky": ["#000004", "#05050c"], "ground": ["#6e6e6e", "#8c8c8a", "#b0afab"], "amp": [50, 26, 12], "sun": {"r": 26, "color": "#ffffff", "x": 0.8, "y": 0.18}, "stars": 1, "weather": "none", "skyBody": "earth", "survival": {"threats": [{"kind": "vacuum", "factIds": ["moon.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue"]}, {"kind": "heat", "factIds": ["moon.surface_temp"]}, {"kind": "cold", "factIds": ["moon.surface_temp"]}, {"kind": "radiation", "factIds": ["moon.radiation", "earth.radiation_dose"]}], "helmetOff": {"text": "Через 9–11 секунд потеряешь сознание: на Луне вакуум, и вода в теле закипает. Если за 60–90 секунд вернуть давление, ещё можно спасти.", "factIds": ["moon.pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue", "earth.body_boiling_pressure"]}}},
  {"id": "mars", "name": "Марс", "kind": "Красная планета", "temp": "в среднем −63 °C", "g": 0.38, "day": "24 ч 39 мин", "air": "Разрежённый углекислый газ", "pressure": "0,006 атм", "desc": "Небо днём розоватое от пыли, а закаты голубые — пыль рассеивает свет наоборот. Ветер гоняет пыльные бури размером с континент.", "sky": ["#c79a8e", "#e6c3b2"], "ground": ["#8a4a2c", "#a65a33", "#bf6c3d"], "amp": [70, 40, 16], "sun": {"r": 17, "color": "#fff3e0", "x": 0.7, "y": 0.24}, "stars": 0, "weather": "dust", "survival": {"threats": [{"kind": "vacuum", "factIds": ["mars.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue"]}, {"kind": "no_oxygen", "factIds": ["mars.atmosphere", "mars.oxygen", "earth.anoxia_fatal"]}, {"kind": "cold", "factIds": ["mars.surface_temp"]}, {"kind": "radiation", "factIds": ["mars.radiation", "earth.radiation_dose"]}], "helmetOff": {"text": "Давление 0,006 атм — намного ниже 6,3 кПа, при которых вода в теле закипает. Через 9–11 секунд потеряешь сознание, а кислорода в воздухе всего 0,16 %.", "factIds": ["mars.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "mars.oxygen"]}}},
  {"id": "jupiter", "name": "Юпитер", "kind": "Газовый гигант — встать некуда", "temp": "≈ −110 °C у верхних облаков", "g": 2.53, "day": "9 ч 56 мин", "air": "Водород и гелий", "pressure": "растёт до миллионов атм в глубине", "desc": "Твёрдой поверхности нет: здесь можно только парить на зонде среди аммиачных облаков. Тело весит в два с половиной раза больше.", "sky": ["#6d4d36", "#c49a6c"], "ground": ["#d9b98f", "#c99d6f", "#e6d3b3"], "amp": [25, 18, 12], "sun": {"r": 8, "color": "#fff8e8", "x": 0.65, "y": 0.15}, "stars": 0, "weather": "clouds", "gas": true, "survival": {"threats": [{"kind": "no_surface", "factIds": ["jupiter.no_surface"]}, {"kind": "crush", "factIds": ["jupiter.probe_depth", "jupiter.pressure"]}, {"kind": "heat", "factIds": ["jupiter.probe_depth"]}, {"kind": "no_oxygen", "factIds": ["jupiter.atmosphere", "earth.anoxia_fatal"]}], "helmetOff": {"text": "Стоять негде: твёрдой поверхности нет, ты просто падаешь. Зонд «Галилео» замолчал там, где 22 бар и +156 °C, — а это ещё не дно.", "factIds": ["jupiter.no_surface", "jupiter.probe_depth"]}}},
  {"id": "titan", "name": "Титан", "kind": "Спутник Сатурна", "temp": "−179 °C", "g": 0.14, "day": "16 земных суток", "air": "Азот с метановой дымкой", "pressure": "1,5 атм", "desc": "Единственный спутник с плотной атмосферой. Идут метановые дожди: капли крупные и падают медленно. Есть реки и моря из жидкого метана и этана.", "sky": ["#8a5a1e", "#d79a45"], "ground": ["#3d2a15", "#4e3519", "#62431f"], "amp": [40, 24, 12], "stars": 0, "weather": "rain", "skyBody": "saturn", "survival": {"threats": [{"kind": "no_oxygen", "factIds": ["titan.atmosphere", "titan.no_pressure_suit", "earth.anoxia_fatal"]}, {"kind": "cold", "factIds": ["titan.surface_temp"]}], "safe": [{"kind": "pressure", "factIds": ["titan.pressure", "titan.no_pressure_suit"]}], "helmetOff": {"text": "Давление 1,5 бар — кровь не закипит, скафандр под давлением не нужен. Но кислорода нет: сознание уйдёт почти сразу, через 90–180 секунд — смерть. И мороз −179,5 °C.", "factIds": ["titan.pressure", "titan.no_pressure_suit", "earth.anoxia_fatal", "titan.surface_temp"]}}},
  {"id": "europa", "name": "Европа", "kind": "Ледяной спутник Юпитера", "temp": "≈ −160 °C", "g": 0.134, "day": "3,5 земных суток", "air": "Следы кислорода", "pressure": "≈0", "desc": "Под ледяной коркой, вероятно, лежит океан, в котором воды больше, чем на Земле. Над горизонтом висит Юпитер.", "sky": ["#000006", "#06061a"], "ground": ["#a9b8c2", "#c7d3d9", "#e3ebee"], "amp": [30, 16, 8], "sun": {"r": 6, "color": "#ffffff", "x": 0.85, "y": 0.15}, "stars": 1, "weather": "none", "skyBody": "jupiter", "survival": {"threats": [{"kind": "vacuum", "factIds": ["europa.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue"]}, {"kind": "cold", "factIds": ["europa.surface_temp"]}, {"kind": "radiation", "factIds": ["europa.radiation"]}], "helmetOff": {"text": "Через 9–11 секунд потеряешь сознание: вокруг почти вакуум. А даже в скафандре радиация Юпитера дала бы здесь смертельную дозу за считаные часы.", "factIds": ["europa.pressure", "earth.vacuum_consciousness", "europa.radiation"]}}},
  {"id": "pluto", "name": "Плутон", "kind": "Карликовая планета", "temp": "≈ −230 °C", "g": 0.063, "day": "6,4 земных суток", "air": "Тонкий азот с голубой дымкой", "pressure": "≈0,00001 атм", "desc": "Равнины из азотного льда и горы из водяного. Солнце отсюда светит в сотни раз слабее, чем на Земле, а прыжок уносит почти на восемь метров вверх.", "sky": ["#000004", "#1b2a4a"], "ground": ["#8d7d6e", "#c9b6a0", "#efe5d8"], "amp": [45, 22, 10], "sun": {"r": 3, "color": "#ffffff", "x": 0.6, "y": 0.25}, "stars": 1, "weather": "snow", "survival": {"threats": [{"kind": "vacuum", "factIds": ["pluto.pressure", "earth.body_boiling_pressure", "earth.vacuum_consciousness", "earth.vacuum_rescue"]}, {"kind": "cold", "factIds": ["pluto.surface_temp"]}], "helmetOff": {"text": "Давление ≈0,00001 атм — почти вакуум: через 9–11 секунд потеряешь сознание. А вокруг ≈ −232 °C.", "factIds": ["pluto.pressure", "earth.vacuum_consciousness", "pluto.surface_temp"]}}},
  {"id": "trappist", "name": "TRAPPIST-1e", "kind": "Экзопланета, 40 световых лет", "temp": "≈ −22 °C (оценка)", "g": 0.82, "day": "Всегда одной стороной к звезде", "air": "Неизвестно", "pressure": "Неизвестно", "desc": "Каменная планета у красного карлика, одна из самых перспективных для поиска жизни. Как она выглядит, никто не знает — это художественная модель.", "sky": ["#3a1220", "#b8503a"], "ground": ["#2b2a2a", "#3a3533", "#4a423c"], "amp": [55, 32, 14], "sun": {"r": 60, "color": "#ff7a4a", "x": 0.78, "y": 0.3}, "stars": 0.4, "weather": "none", "model": true, "survival": {"threats": [{"kind": "unknown", "factIds": ["trappist.atmosphere", "trappist.pressure"]}, {"kind": "cold", "factIds": ["trappist.surface_temp"]}, {"kind": "radiation", "factIds": ["trappist.star_flares"]}], "helmetOff": {"text": "Никто не знает. Есть ли тут воздух и какое давление — неизвестно. Расчётная температура ≈ −22 °C, а звезда часто вспыхивает. Снимать шлем — опыт, который пока не на ком проверить.", "factIds": ["trappist.atmosphere", "trappist.pressure", "trappist.surface_temp", "trappist.star_flares"]}}}
]
